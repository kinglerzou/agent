{
  "name": "@studio/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit && tsup src/index.ts --format esm --out-dir dist",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@studio/shared": "1.0.0",
    "express": "^5.1.0",
    "dotenv": "^17.2.0",
    "zod": "^4.1.0",
    "langchain": "^1.0.0",
    "@langchain/openai": "^1.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "tsx": "^4.20.0",
    "tsup": "^8.5.0"
  }
}
