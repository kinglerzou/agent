GAME_LLM_BASE_URL=https://api.deepseek.com
GAME_LLM_MODEL=deepseek-flash
GAME_LLM_API_KEY=
GAME_DATABASE_URL=postgresql://localhost/game_ops
GAME_DB_SCHEMA=game_ops
GAME_REDIS_URL=redis://127.0.0.1:6379/0
GAME_REDIS_PREFIX=game-ops
# Local-only server identity; replace with verified SSO identity for multi-user deployments.
GAME_OWNER_ID=local-operator

# Local multilingual embeddings (download with scripts/prepare-game-embeddings.py)
GAME_EMBEDDING_CACHE_DIR=data/embeddings
GAME_RETRIEVAL_STRATEGY=bm25
GAME_MIN_SIMILARITY=0.35
GAME_VECTOR_BACKEND=pgvector
GAME_VECTOR_SEARCH_MODE=exact
